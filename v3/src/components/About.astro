---
import { about } from '../data/site';
import Copy from './Copy.astro';
import { W, H, land, coast, borders, paraguay, river, asuncion, names, ports } from '../data/paraguaymap';

// Zoom: starts close on Asunción (centred), ends on the whole country. Driven by --z (0 → 1).
const K = 7; // extra scale at the start (8×): Gran Asunción, where the ports around the office read as separate dots
const [ax, ay] = asuncion;
const cx = W / 2 - ax, cy = H / 2 - ay;
const near = '(1 - var(--z, 1))';
const zoom = `transform-origin:${ax}px ${ay}px;` +
  `transform:translate(calc(${cx}px * ${near}), calc(${cy}px * ${near})) scale(calc(1 + ${near} * ${K}));`;
// Dots and names sit outside the zoomed group so they keep their size; this makes them follow it instead.
const follow = ([x, y]: number[]) =>
  `transform:translate(calc(${ax}px + ${(x - ax).toFixed(1)}px * (1 + ${near} * ${K}) + ${cx}px * ${near}), ` +
  `calc(${ay}px + ${(y - ay).toFixed(1)}px * (1 + ${near} * ${K}) + ${cy}px * ${near})) scale(var(--mark, 1));`;

const side = {
  right: { dx: '.7em', dy: '.35em', 'text-anchor': 'start' },
  left: { dx: '-.7em', dy: '.35em', 'text-anchor': 'end' },
  above: { dy: '-.8em', 'text-anchor': 'middle' },
  below: { dy: '1.5em', 'text-anchor': 'middle' },
};
const alt = 'Mapa del Paraguay con nuestra sede en Asunción' +
  (ports.length ? ` y los puertos que cubrimos: ${ports.map(p => p.name).join(', ')}.` : '.');
---
<section class="about" id="nosotros" data-about>
  <div class="stage">
    <div class="wrap panel">
      <div class="copy">
        <h2 class="h2">¿Quiénes somos?</h2>
        <p class="big"><Copy text={about.lead} /></p>
        <p>{about.body}</p>
        <p class="sign">
          <span class="sign-name">{about.signature.name}</span>
          <span class="sign-role">{about.signature.role}</span>
        </p>
      </div>
      <svg class="map" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label={alt}>
        <!-- Paraguay is landlocked, so the map has no shore to end on: on phones the neighbours fade
             out around it (this mask); on desktop the section's own fade does it (.stage::after) -->
        <defs>
          <radialGradient id="fade" gradientUnits="userSpaceOnUse" cx={W / 2} cy={H / 2} r={W / 2}>
            <stop offset=".82" stop-color="#fff" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="vignette" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
            <rect width={W} height={H} fill="url(#fade)" />
          </mask>
        </defs>
        <g class="fade">
          <g class="world" style={zoom}>
            <path class="land" d={land} />
            <path class="borders" d={borders} />
            <path class="coast" d={coast} />
            <path class="py" d={paraguay} />
            <path class="river" d={river} />
          </g>
        </g>
        {names.map(n => (
          <g style={follow(n.at)}><text class:list={['country', { home: n.home }]} text-anchor="middle">{n.name}</text></g>
        ))}
        {ports.map((p, i) => (
          <g class:list={['port', { near: p.near }]} style={`--f:${(i / ports.length).toFixed(3)};${follow([p.x, p.y])}`}>
            <title>{p.name}</title>
            <circle r={p.near ? 2.8 : 3.6} />
            {p.label !== 'none' && <text {...side[p.label ?? 'right']}>{p.name}</text>}
          </g>
        ))}
        <g class="asu" style={follow(asuncion)}>
          <circle class="pulse" r="4" />
          <circle class="pin" r="4.5" />
          <text {...side.left}>Asunción</text>
        </g>
      </svg>
      <p class="caption">{about.caption}</p>
      <div class="ports">
        <p class="ports-label"><span class="dot" aria-hidden="true"></span>{about.ports.label}</p>
        <ul>{about.ports.names.map(n => <li>{n}</li>)}</ul>
        <p class="more">{about.ports.more}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { onScroll, clamp, reduceMotion } from '../scripts/scroll';
  const sec = document.querySelector<HTMLElement>('[data-about]')!;
  const map = sec.querySelector<SVGSVGElement>('.map')!;
  const wide = matchMedia('(min-width: 901px)');

  if (reduceMotion()) sec.style.setProperty('--z', '1');
  else onScroll(vh => {
    let z: number;
    if (wide.matches) {
      const r = sec.getBoundingClientRect();
      z = clamp(-r.top / (r.height - vh));           // pinned: progress through the section
    } else {
      const r = map.getBoundingClientRect();
      // small screens: hold the Gran Asunción close-up until it is on screen (map top at 55% of the
      // screen), then zoom out fully by the time the whole map is in view (map top at 10%)
      z = clamp((vh * 0.55 - r.top) / (vh * 0.45));
    }
    sec.style.setProperty('--z', z.toFixed(4));
  });
</script>

<style>
  .about { position: relative; background: var(--alt); color: var(--body); }
  .stage { position: relative; overflow: hidden; }

  /* ---- map ---- */
  .map { display: block; width: 100%; height: auto; }
  .fade { mask: url(#vignette); }
  .world { will-change: transform; }
  .land { fill: rgba(8, 120, 186, .06); }
  .coast { fill: none; stroke: rgba(8, 120, 186, .55); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .borders { fill: none; stroke: rgba(8, 120, 186, .32); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .py { fill: var(--sky); fill-opacity: .24; stroke: var(--sky-d); stroke-width: 1.6; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .river { fill: none; stroke: var(--sky-d); stroke-opacity: .6; stroke-width: 1.2; stroke-linejoin: round; vector-effect: non-scaling-stroke; }

  text { paint-order: stroke; stroke: var(--alt); stroke-width: 3px; stroke-linejoin: round; }
  .country {
    font: 600 11px var(--text); letter-spacing: .22em; text-transform: uppercase; fill: var(--muted); stroke: none;
    opacity: clamp(0, var(--z, 1) * 3 - 1.5, 1); /* out of frame until the zoom-out is half done */
  }
  .country.home { font: 800 15px var(--display); font-stretch: 115%; fill: var(--sky-d); }

  /* each port fades in once the zoom-out has gone far enough to reach it (--f: 0 nearest … 1 farthest) */
  .port { opacity: clamp(0, (var(--z, 1) - .2 - var(--f) * .55) * 6, 1); }
  /* the ports around Asunción are on screen from the start, while the map is zoomed in on them;
     their names fade out early in the zoom-out, when the dots close in on the office */
  .port.near { opacity: 1; }
  .port.near text { opacity: clamp(0, (.32 - var(--z, 1)) * 7, 1); }
  .port circle { fill: var(--navy); stroke: #fff; stroke-width: 1.2; }
  .port text { font: 600 13px var(--text); fill: var(--h); }
  /* the unnamed ports around Asunción: smaller and brighter, read as a cluster around the office */
  .port.near circle { fill: var(--sky-d); stroke-width: 1; }

  .pin { fill: var(--sky); stroke: var(--navy); stroke-width: 2; }
  .pulse { fill: var(--sky); transform-box: fill-box; transform-origin: center; animation: pulse 2.2s ease-out infinite; }
  @keyframes pulse { from { transform: scale(1); opacity: .7; } to { transform: scale(5); opacity: 0; } }
  .asu text { font: 700 15px var(--display); fill: var(--navy); }

  /* ---- copy ---- */

  .copy { display: grid; gap: 1.5rem; max-width: 30rem; }
  .h2 { color: var(--h); }
  .big { font-size: 1.25rem; color: var(--h); }

  /* the founder signs off the text above: a short rule, his name, his title */
  .sign { display: grid; gap: .25rem; padding-left: 2.6rem; position: relative; }
  .sign::before { content: ""; position: absolute; left: 0; top: .8em; width: 1.8rem; height: 2px; background: var(--sky-d); }
  .sign-name { font: 700 1.15rem/1.3 var(--display); font-stretch: 108%; color: var(--h); }
  .sign-role { font-size: .9rem; color: var(--muted); }

  /* the main ports by name; the dot matches the unnamed dots around Asunción on the map */
  .ports { padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .ports-label {
    display: flex; align-items: center; gap: .5rem;
    font: 700 .78rem/1 var(--text); letter-spacing: .14em; text-transform: uppercase; color: var(--sky-d);
  }
  .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--sky-d); box-shadow: 0 0 0 2px #fff; }
  .ports ul { margin-top: .6rem; color: var(--h); font-weight: 600; line-height: 1.6; }
  .ports li { display: inline; white-space: nowrap; }
  /* the separator stays with the name before it, so no line starts with "·" */
  .ports li:not(:last-child)::after { content: " · "; color: var(--sky-d); white-space: normal; }
  .more { margin-top: .3rem; font-size: .95rem; color: var(--muted); }
  .caption { font-size: .82rem; color: var(--muted); }

  /* ---- wide screens: a pinned stage. The map fills it as a background; over it, in three columns,
     the text at the bottom left, the caption at the bottom centre, the ports at the top right ---- */
  @media (min-width: 901px) {
    .about { height: 200vh; }
    .stage { position: sticky; top: 0; height: 100vh; }
    /* nudged right of centre: the text column on the left is taller than the ports block on the
       right, which only takes the top, where Paraguay is narrow */
    .map {
      position: absolute; z-index: 0; left: 3%; top: var(--header);
      width: 100%; height: calc(100% - var(--header));
    }
    .fade { mask: none; }
    /* the map dissolves into the page towards both sides and the bottom, so the text stays legible */
    .stage::after {
      content: ""; position: absolute; z-index: 1; inset: var(--header) 0 0; pointer-events: none;
      background:
        linear-gradient(90deg, var(--alt) 4%, rgba(242, 246, 250, .8) 22%, rgba(242, 246, 250, 0) 40%,
          rgba(242, 246, 250, 0) 64%, rgba(242, 246, 250, .8) 80%, var(--alt) 96%),
        linear-gradient(0deg, var(--alt), rgba(242, 246, 250, 0) 16%);
    }
    .copy, .caption, .ports { position: relative; z-index: 2; }
    .panel {
      height: 100%; display: grid; column-gap: clamp(24px, 3vw, 3rem);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, .8fr);
      grid-template-rows: minmax(0, 1fr) auto;
      padding-block: calc(var(--header) + 24px) 28px;
    }
    .copy { grid-column: 1; grid-row: 1 / 3; align-self: end; }
    .caption { grid-column: 2; grid-row: 2; padding-top: 8px; text-align: center; }
    .ports { grid-column: 3; grid-row: 1 / 3; align-self: start; }
  }
  /* between tablets and laptops three columns squeeze the text: two instead, the text over the
     ports on the left, the map on the right */
  @media (min-width: 901px) and (max-width: 1199px) {
    .panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); grid-template-rows: minmax(0, 1fr) auto auto; }
    .copy { grid-row: 1; }
    .ports { grid-column: 1; grid-row: 2 / 4; margin-top: 1.5rem; }
    .caption { grid-row: 3; }
    /* the text fills the left half here, so the map keeps to the right, and the fade only covers
       the text side (hiding the map's left edge too) */
    .map { left: 40%; width: 60%; }
    .stage::after {
      background:
        linear-gradient(90deg, var(--alt) 41%, rgba(242, 246, 250, 0) 52%, rgba(242, 246, 250, 0) 95%, var(--alt)),
        linear-gradient(0deg, var(--alt), rgba(242, 246, 250, 0) 16%);
    }
  }
  /* phones and tablets: text, the map and its caption, then the ports */
  @media (max-width: 900px) {
    .panel { display: flex; flex-direction: column; gap: 24px; padding-block: var(--section) 32px; }
    .map { order: 1; }
    .caption { order: 2; }
    .ports { order: 3; }
    /* wider than the screen so the country fills it; the map is still drawn at about half size,
       so dots and names are scaled back up */
    .map { width: 120%; margin-inline: -10%; --mark: 1.5; }
  }
</style>
