---
import { reasons, media } from '../data/site';
import Copy from './Copy.astro';

// Lucide icons (src/icons), inlined so they inherit the brand colour. Same order as `reasons` in site.ts.
import badgeCheck from '../icons/badge-check.svg?raw';
import handshake from '../icons/handshake.svg?raw';
import zap from '../icons/zap.svg?raw';
import landmark from '../icons/landmark.svg?raw';
import shieldCheck from '../icons/shield-check.svg?raw';

const clean = (svg: string) => svg
  .replace(/\s(width|height|class)="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');
const icons = [badgeCheck, handshake, zap, landmark, shieldCheck].map(clean);
---
<section class="why light" id="por-que">
  <div class="wrap grid">
    <picture class="globe">
      <source media="(prefers-reduced-motion: reduce)" srcset={media.globeStill} />
      <img src={media.globe} alt="" width="480" height="480" loading="lazy" decoding="async" />
    </picture>
    <div>
      <h2 class="h2">¿Por qué elegirnos?</h2>
      <ul class="reasons">
        {reasons.map((r, i) => (
          <li><span class="icon" set:html={icons[i]} /><strong><Copy text={r} /></strong></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .why { background: var(--alt); color: var(--body); padding-block: var(--section); }
  .grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(24px, 7vw, 110px); align-items: center; }
  .grid > * { min-width: 0; }
  .globe { display: block; width: 100%; max-width: 440px; justify-self: center; }
  .globe img { width: 100%; }
  .h2 { margin-bottom: 1.8rem; }
  .reasons li {
    display: grid; grid-template-columns: 40px 1fr; gap: 18px; align-items: center;
    padding-block: 18px; border-top: 1px solid var(--line);
  }
  .reasons li:last-child { border-bottom: 1px solid var(--line); }
  .icon { display: grid; place-items: center; width: 40px; height: 40px; color: var(--sky-d); }
  .icon :global(svg) { width: 30px; height: 30px; stroke-width: 1.8; }
  .reasons strong { font-weight: 600; font-size: 1.12rem; color: var(--h); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .globe { max-width: 280px; }
  }
</style>
