---
// "Rubros": one card per sector the agency's clients work in. Each card is a lit stage for the
// sector's product render (big, cropped by the card's bottom and right edges), with the copy top-left.
import { sectors, sectorsIntro } from '../data/site';
---
<section class="sectors" id="sectores" data-sectors>
  <div class="wrap">
    <header class="head">
      <h2 class="h2">{sectorsIntro.title}</h2>
      <p class="lede">{sectorsIntro.lede}</p>
    </header>
    <ul class="cards">
      {sectors.map(s => (
        <li class="card">
          <img class="obj" src={s.img} alt="" width="1254" height="1254" loading="lazy" decoding="async" />
          <div class="copy">
            <h3>{s.name}</h3>
            <p class="goods">{s.goods}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { onScroll, clamp, reduceMotion } from '../scripts/scroll';
  const list = document.querySelector<HTMLElement>('[data-sectors] .cards')!;
  const cards = [...list.querySelectorAll<HTMLElement>('.card')];
  const ease = (t: number) => t * t * (3 - 2 * t);

  // Per card: --t (0 → 1) rises it into place as it enters, cards further right a beat later;
  // --y (-1 → 1) as it crosses the screen drifts the product upwards, a slow parallax.
  // On phones the cards are a horizontal carousel, so only the first card's column delay applies.
  if (!reduceMotion()) {
    const frame = (vh: number) => {
      const box = list.getBoundingClientRect();
      for (const c of cards) {
        const r = c.getBoundingClientRect();
        const lag = clamp((r.left - box.left) / box.width) * .5;
        c.style.setProperty('--t', ease(clamp((vh * .98 - r.top) / (vh * .35) - lag)).toFixed(4));
        c.style.setProperty('--y', clamp((vh / 2 - (r.top + r.height / 2)) / vh * 2, -1, 1).toFixed(4));
      }
    };
    onScroll(frame);
    list.addEventListener('scroll', () => frame(innerHeight), { passive: true });
  }
</script>

<style>
  .sectors { background: var(--navy); padding-block: var(--section); }
  /* the lede keeps a readable width; the heading wraps instead of squeezing it */
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem); gap: 16px 56px; align-items: end; margin-bottom: clamp(28px, 4vw, 3rem); }
  .head > * { min-width: 0; }

  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 1.5rem); }

  .card {
    position: relative; isolation: isolate; overflow: hidden;
    aspect-ratio: 4 / 5; border-radius: 16px;
    /* a spotlight behind the product, a cooler fill from the top, the ribs of a container side */
    background:
      radial-gradient(circle at 70% 70%, rgba(27, 164, 240, .5), transparent 52%),
      radial-gradient(ellipse at 10% 0%, rgba(77, 184, 244, .16), transparent 55%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, .025) 0 3px, transparent 3px 12px),
      linear-gradient(165deg, #10407a, var(--deep) 72%);
    box-shadow: inset 0 0 0 1px rgba(143, 210, 248, .16), 0 24px 48px -24px rgba(0, 0, 0, .7);
    opacity: var(--t, 1);
    transform: translateY(calc((1 - var(--t, 1)) * 48px)) scale(calc(.96 + var(--t, 1) * .04));
  }
  /* keeps the copy legible where the product reaches up behind it */
  .card::after {
    content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(4, 20, 41, .6), transparent 42%);
  }

  .obj {
    position: absolute; z-index: 0; width: 92%; max-width: none; right: -16%; bottom: -6%;
    filter: drop-shadow(0 26px 30px rgba(0, 0, 0, .55));
    transform:
      translateY(calc(var(--y, 0) * -28px + (1 - var(--t, 1)) * 40px))
      rotate(calc(var(--y, 0) * -2deg))
      scale(var(--s, 1));
    transition: transform .6s cubic-bezier(.2, .7, .2, 1);
  }

  .copy { position: relative; z-index: 1; padding: clamp(1.25rem, 2vw, 1.75rem); }
  h3 { font: 800 clamp(1.7rem, 2.3vw, 2.3rem)/1 var(--display); font-stretch: 112%; color: #fff; }
  .goods { margin-top: .6rem; max-width: 15rem; font-size: .98rem; line-height: 1.4; color: var(--d-text); }

  @media (hover: hover) {
    .card:hover .obj { --s: 1.06; }
  }

  @media (max-width: 1100px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; }
  }
  /* phones: a swipeable row, each card most of the screen wide so the next one peeks in */
  @media (max-width: 720px) {
    .cards {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 82%;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
    }
    .cards::-webkit-scrollbar { display: none; }
    .card { scroll-snap-align: start; aspect-ratio: 4 / 5.2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .obj { transition: none; }
  }
</style>
