---
import { sectors, containerCode } from '../data/site';
---
<section class="sectors" id="sectores" data-doors>
  <div class="wrap">
    <header class="head">
      <h2 class="h2">Clientes que confían en nosotros</h2>
      <p class="lede">Atendemos desde pymes hasta grandes industrias, con mercaderías de sectores muy distintos.</p>
    </header>
    <ul class="grid">
      {sectors.map((s, i) => (
        <li class="unit">
          <div class="frame">
            <div class="hold">
              <img class="cargo" src={s.img} alt="" width="720" height="720" loading="lazy" decoding="async" />
            </div>
            <div class="door left" aria-hidden="true"><span class="code">{containerCode(i + 6)}</span></div>
            <div class="door right" aria-hidden="true"></div>
          </div>
          <div class="label">
            <h3>{s.name}</h3>
            <p>{s.goods}</p>
            <p class="ncm"><span>NCM cap.</span> {s.ncm.join(' · ')}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { onScroll, clamp, reduceMotion } from '../scripts/scroll';
  const units = [...document.querySelectorAll<HTMLElement>('[data-doors] .unit')];
  if (reduceMotion()) units.forEach(u => u.style.setProperty('--o', '1'));
  else onScroll(vh => {
    for (const u of units) {
      const r = u.getBoundingClientRect();
      u.style.setProperty('--o', clamp((vh * 0.9 - r.top) / (vh * 0.45)).toFixed(4));
    }
  });
</script>

<style>
  .sectors { background: var(--navy); padding-block: var(--section); }
  .head { display: flex; flex-wrap: wrap; gap: 16px 56px; align-items: end; margin-bottom: clamp(32px, 5vw, 56px); }
  .head > * { min-width: 0; }
  .head .lede { flex: 1 1 22rem; max-width: 30rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 3.4vw, 48px) clamp(16px, 2vw, 28px); }

  /* ---- the container: doors open, the cargo comes forward into the light ---- */
  .frame {
    position: relative; aspect-ratio: 3 / 2; perspective: 1100px;
    border: 6px solid #154c8a; border-radius: 4px; overflow: hidden;
  }
  .hold {
    position: absolute; inset: 0; display: grid; place-items: center;
    background:
      radial-gradient(ellipse 60% 55% at 50% 42%, rgba(77, 184, 244, .28), transparent 70%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, .035) 0 3px, transparent 3px 14px),
      linear-gradient(180deg, #0a2649, var(--deep));
  }
  /* floor line inside the container */
  .hold::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 22%;
    background: linear-gradient(180deg, rgba(4, 20, 41, 0), rgba(4, 20, 41, .7));
    border-top: 1px solid rgba(143, 210, 248, .12);
  }
  .cargo {
    position: relative; z-index: 1; width: 78%; height: 78%; object-fit: contain;
    filter: drop-shadow(0 18px 22px rgba(0, 0, 0, .45));
    transform: translateY(calc((1 - var(--o, 1)) * 14%)) scale(calc(.82 + var(--o, 1) * .18));
    will-change: transform;
  }

  /* door photos: one ChatGPT image split at its centre seam (src-images/sectores/puertas.png) */
  .door {
    position: absolute; z-index: 2; top: 0; bottom: 0; width: 50%;
    background: var(--sky) center / cover no-repeat;
    backface-visibility: hidden;
    /* doors darken as they swing away from the light */
    filter: brightness(calc(1 - var(--o, 0) * .4));
    will-change: transform;
  }
  .door.left { left: 0; background-image: url('/img/sectores/puerta-izq.webp'); transform-origin: left center; transform: rotateY(calc(var(--o, 0) * -104deg)); }
  .door.right { right: 0; background-image: url('/img/sectores/puerta-der.webp'); transform-origin: right center; transform: rotateY(calc(var(--o, 0) * 104deg)); }
  .code {
    position: absolute; top: 14%; left: 14%; padding: 3px 6px; border-radius: 2px;
    font: 400 .78rem/1 var(--stencil); letter-spacing: .08em; color: #fff; background: rgba(7, 30, 61, .55);
  }

  /* ---- label under each container ---- */
  .label { margin-top: 16px; display: grid; gap: 4px; }
  .label h3 { font: 800 1.4rem/1.1 var(--display); font-stretch: 112%; color: #fff; }
  .label p { color: var(--d-muted); font-size: .98rem; }
  .label .ncm { margin-top: 4px; font: 400 .85rem/1 var(--stencil); letter-spacing: .08em; color: var(--sky-l); }
  .ncm span { color: var(--d-muted); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .frame { max-width: 440px; }
  }
  @media (prefers-reduced-motion: reduce) { .cargo { transform: none; } }
</style>
