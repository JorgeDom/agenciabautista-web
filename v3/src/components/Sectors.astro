---
import { sectors } from '../data/site';
---
<section class="sectors" id="sectores" data-sectors>
  <div class="wrap layout">
    <div class="intro">
      <h2 class="h2">Clientes que confían en nosotros</h2>
      <p class="lede">Atendemos desde pymes hasta grandes industrias de los sectores:</p>
      <p class="list">{sectors.map((s, i) => <>{i > 0 && ' '}<span>{s.name}</span></>)}</p>
    </div>
    <ul class="cards">
      {sectors.map((s, i) => (
        <li class="card" style={`--i:${i}`}>
          <img class="cargo" src={s.img} alt="" width="1254" height="1254" loading="lazy" decoding="async" />
          <span class="name">{s.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { onScroll, clamp, reduceMotion } from '../scripts/scroll';
  const list = document.querySelector<HTMLElement>('[data-sectors] .cards')!;
  // one progress value for the row; each card offsets it by its index for a left-to-right rise
  if (reduceMotion()) list.style.setProperty('--o', '1');
  else onScroll(vh => {
    const r = list.getBoundingClientRect();
    list.style.setProperty('--o', clamp((vh * 0.95 - r.top) / (vh * 0.5)).toFixed(4));
  });
</script>

<style>
  .sectors { background: var(--navy); padding-block: var(--section); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(32px, 4vw, 56px); align-items: center; }
  .intro { display: grid; gap: 1rem; }
  .intro > * { min-width: 0; }
  .intro .h2 { font-size: clamp(2rem, 3.4vw, 3rem); }
  .list { color: #fff; font-weight: 600; line-height: 1.6; }
  /* keep each separator with the word before it, so no line starts with "·" */
  .list span { white-space: nowrap; }
  .list span:not(:last-child)::after { content: " ·"; color: var(--sky-l); }

  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .card {
    --t: clamp(0, var(--o, 1) * 1.6 - var(--i) * .12, 1); /* staggered by position */
    position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 6px;
    background:
      radial-gradient(ellipse 80% 55% at 50% 40%, rgba(77, 184, 244, .3), transparent 70%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, .035) 0 3px, transparent 3px 12px),
      linear-gradient(180deg, #0d3463, var(--deep));
    border: 1px solid var(--d-line);
    opacity: calc(.15 + var(--t) * .85);
    transform: translateY(calc((1 - var(--t)) * 36px));
  }
  .cargo {
    /* contain, not cover: the source images are square and untouched, so this
       never crops them — the card's own background shows at the sides instead */
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    filter: drop-shadow(0 14px 16px rgba(0, 0, 0, .45));
    transition: transform .4s cubic-bezier(.2, .7, .2, 1);
  }
  .card:hover .cargo { transform: scale(1.04); }
  .name {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 14px 14px;
    background: linear-gradient(180deg, transparent, rgba(4, 20, 41, .92) 55%);
    font: 700 clamp(1rem, 1.3vw, 1.2rem)/1.15 var(--display); font-stretch: 105%; color: #fff; text-align: center;
  }

  @media (max-width: 1100px) {
    .layout { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .cargo { transition: none; } }
</style>
