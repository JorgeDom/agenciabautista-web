---
import { site } from '../data/site';
import Years from './Years.astro';

// WhatsApp is the brand glyph; mail and Instagram are Lucide outlines, like the icons in "¿Por qué elegirnos?".
// width/height are on the <svg> itself so an icon never collapses to nothing inside its (flex) button.
const line = (d: string) => `<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  whatsapp: '<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z" /></svg>',
  mail: line('<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />'),
  instagram: line('<rect width="20" height="20" x="2" y="2" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />'),
};
---
<section class="contact" id="contacto">
  <div class="wrap grid">
    <div>
      <h2 class="h2">Hablemos de tu próxima operación</h2>
      <p class="lede">Contanos qué necesitás importar o exportar y te respondemos con los pasos, los documentos y los plazos.</p>
      <div class="cta">
        <a class="btn btn--wa" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp" title="Escribir por WhatsApp" set:html={icons.whatsapp} />
        <a class="btn btn--ghost" href={`mailto:${site.emails[0]}`} aria-label="Enviar un email" title="Enviar un email" set:html={icons.mail} />
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener" aria-label="Seguinos en Instagram" title="Seguinos en Instagram" set:html={icons.instagram} />
      </div>
    </div>
    <div class="details">
      <dl class="info">
        <div>
          <dt>Teléfonos / WhatsApp</dt>
          <dd>{site.phones.map((p, i) => <>{i > 0 && <br />}<a href={`tel:${p.tel}`}>{p.label}</a></>)}</dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd>{site.emails.map((e, i) => <>{i > 0 && <br />}<a href={`mailto:${e}`}>{e}</a></>)}</dd>
        </div>
        <div>
          <dt>Dirección</dt>
          <dd>{site.address[0]}<br />{site.address[1]}</dd>
        </div>
      </dl>
      <div class="map">
        <iframe
          src={site.mapsEmbed}
          title="Mapa: Mayor Bullo 540, Asunción"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap row">
    <img src="/img/logo-agencia-bautista.png" alt="Agencia Bautista, Despacho Aduanero" width="2172" height="724" loading="lazy">
    <p>© <Years current /> {site.legal} · Despacho Aduanero · Asunción, Paraguay</p>
  </div>
</footer>

<a class="wa" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp" set:html={icons.whatsapp} />

<style>
  .contact { background: var(--deep); padding-block: var(--section); }
  .grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .grid > * { min-width: 0; }
  .h2 { font-size: clamp(2.3rem, 5vw, 4rem); }
  .lede { margin-block: 1.2rem 2rem; font-size: 1.1rem; }
  /* icon-only buttons: round, same colours as the text buttons elsewhere */
  .cta { gap: 14px; }
  .cta .btn { width: 3.625rem; height: 3.625rem; padding: 0; }
  /* the size attributes on each <svg> are the fallback; these let the icons grow on big screens */
  .cta :global(svg) { width: 1.625rem; height: 1.625rem; }
  .cta .btn--wa :global(svg), .wa :global(svg) { width: 1.875rem; height: 1.875rem; }
  .map {
    margin-top: 24px; aspect-ratio: 16 / 10;
    border-radius: 6px; overflow: hidden; border: 1px solid var(--d-line); background: var(--card);
  }
  .map iframe { display: block; width: 100%; height: 100%; border: 0; }
  .info > div { padding-block: 20px; border-top: 1px solid var(--d-line); }
  .info > div:last-child { border-bottom: 1px solid var(--d-line); }
  dt { color: var(--d-muted); font-size: .9rem; margin-bottom: 6px; }
  dd { color: #fff; font-size: 1.1rem; overflow-wrap: anywhere; }
  dd a { color: var(--sky-l); text-underline-offset: 3px; }
  dd a[href^="tel"] { color: #fff; text-decoration: none; font-variant-numeric: tabular-nums; }

  .foot { background: #020c19; color: var(--d-muted); padding-block: 36px; font-size: .9rem; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .foot img { height: 3.125rem; width: auto; }

  .wa {
    position: fixed; right: 20px; bottom: 20px; z-index: 40; width: 3.625rem; height: 3.625rem; border-radius: 50%;
    display: grid; place-items: center; background: var(--wa); color: var(--deep);
    box-shadow: 0 8px 24px rgba(4, 20, 41, .35);
  }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .foot img { height: 40px; } }
</style>
