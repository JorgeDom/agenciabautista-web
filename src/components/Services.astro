---
import { services, containerCode, media } from '../data/site';
// Desktop stacks the containers like a yard: bottom row first (left → right), then the
// top row on top of it. DOM order stays the reading order (services 1–6) for mobile and
// screen readers; the grid placement below only applies to the staged desktop scene.
const place = (i: number) => `--row:${i < 3 ? 2 : 1};--col:${(i % 3) + 1}`;
---
<section class="services" id="servicios" data-yard>
  <div class="pin">
    <div class="wrap">
      <header class="head">
        <h2 class="h2">Servicios</h2>
        <p class="lede">Soluciones integrales para que tu operación sea segura, eficiente y cumpla con la normativa vigente.</p>
      </header>
      <ol class="slots">
        {services.map((s, i) => (
          <li class="slot" style={place(i)}>
            <div class="rig" aria-hidden="true">
              {media.spreader
                ? <img class="spreader-img" src={media.spreader} alt="" width="1000" height="258" />
                : <span class="spreader-bar"></span>}
            </div>
            <div class={`box box--${s.tone} cont`}>
              <span class="code">{containerCode(i)}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.detail}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { onScroll, clamp, reduceMotion } from '../scripts/scroll';

  const sec = document.querySelector<HTMLElement>('[data-yard]')!;
  const slots = [...sec.querySelectorAll<HTMLElement>('.slot')];
  const boxes = slots.map(s => s.querySelector<HTMLElement>('.cont')!);
  const rigs = slots.map(s => s.querySelector<HTMLElement>('.rig')!);
  const wide = matchMedia('(min-width: 901px)');
  let drop: number[] = []; // px each container starts above its slot (fully out of the pinned stage)

  function measure() {
    const staged = wide.matches && !reduceMotion();
    sec.classList.toggle('staged', staged);
    // leaving the staged scene (window narrowed, tablet rotated): clear what the crane left on
    // the containers, or the ones it hadn't lowered yet would stay hidden
    if (!staged) boxes.forEach((b, i) => {
      b.style.visibility = b.style.transform = '';
      rigs[i].style.visibility = rigs[i].style.transform = '';
    });
    // staged: .slot is positioned and .pin is sticky, so offsetTop is relative to the stage
    drop = slots.map(s => s.offsetTop + s.offsetHeight + 80);
  }

  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeIn = (t: number) => t * t;

  onScroll(vh => {
    if (!sec.classList.contains('staged')) {
      // small screens: containers slide in from alternating sides
      if (reduceMotion()) return;
      boxes.forEach((b, i) => {
        const r = b.getBoundingClientRect();
        const t = 1 - clamp((vh * 1.02 - r.top) / (vh * 0.42));
        b.style.transform = `translateX(${t * (i % 2 ? 60 : -60)}vw) rotate(${t * (i % 2 ? -4 : 4)}deg)`;
      });
      return;
    }
    // one "turn" per container; each turn: lower (0–.7), set down, release and hoist away (.75–1)
    const r = sec.getBoundingClientRect();
    const k = clamp(-r.top / (r.height - vh)) * (boxes.length + 0.4);
    boxes.forEach((b, i) => {
      const d = clamp(k - i);
      const lower = easeOut(clamp(d / 0.7));
      const hoist = easeIn(clamp((d - 0.75) / 0.25));
      const ty = -drop[i] * (1 - lower);
      b.style.transform = `translateY(${ty.toFixed(1)}px)`;
      b.style.visibility = d > 0 ? 'visible' : 'hidden';
      rigs[i].style.transform = `translateY(${(ty - hoist * drop[i]).toFixed(1)}px)`;
      rigs[i].style.visibility = d > 0 && d < 1 ? 'visible' : 'hidden';
    });
  }, measure);
</script>

<style>
  .services { background: var(--navy); }
  .pin { padding-block: var(--section); }
  .head { display: grid; grid-template-columns: auto 1fr; gap: 16px 56px; align-items: end; margin-bottom: clamp(28px, 4vw, 48px); }
  .head > * { min-width: 0; }

  .slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px 18px; }
  .rig { display: none; }
  .cont {
    display: grid; align-content: space-between; gap: 18px;
    min-height: 10.5rem; padding: 1rem 4rem 1.125rem 1.25rem; height: 100%;
    will-change: transform;
  }
  .cont h3 { font: 800 clamp(1.45rem, 2.4vw, 1.9rem)/1.12 var(--display); font-stretch: 112%; }
  .cont p { font-size: 1.08rem; margin-top: 6px; opacity: .9; }

  /* ---- staged (desktop): a pinned yard, containers lowered in and stacked 2 × 3 ---- */
  .services.staged { height: 320vh; }
  .staged .pin {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
    padding-block: calc(var(--header) + 16px) 40px;
  }
  /* the heading band sits above the drop zone, so loads emerge from behind it
     instead of sliding across the title */
  .staged .head { position: relative; z-index: 4; }
  .staged .head::before {
    content: ""; position: absolute; z-index: -1; left: -100vw; right: -100vw; top: -100vh; bottom: -14px;
    background: var(--navy);
  }
  /* stacked: almost no gap between rows, a narrow aisle between columns */
  .staged .slots { gap: 5px 16px; }
  .staged .slot { position: relative; grid-row: var(--row); grid-column: var(--col); }
  .staged .cont { visibility: hidden; min-height: clamp(150px, 21vh, 15rem); }
  /* ground line under the bottom row */
  .staged .slots::after {
    content: ""; grid-row: 3; grid-column: 1 / -1; height: 2px; margin-top: 3px;
    background: repeating-linear-gradient(90deg, var(--d-line) 0 10px, transparent 10px 18px);
  }

  /* the spreader rides on top of its container; cables run up out of the stage */
  .staged .rig {
    display: block; position: absolute; z-index: 3; left: 4%; right: 4%; bottom: calc(100% - 2px);
    visibility: hidden; will-change: transform;
  }
  .rig::before {
    content: ""; position: absolute; bottom: 100%; left: 32%; right: 32%; height: 150vh;
    border-inline: 2px solid #b9c7d6;
  }
  /* spreader.webp (1000×258): lifting lugs centred at 42.7% and 56.7% of the width,
     so the cables drop onto them; the twistlocks bite slightly into the container roof */
  .staged .rig:has(.spreader-img) { bottom: calc(100% - 7px); }
  .rig:has(.spreader-img)::before { bottom: calc(100% - 4px); left: 42.4%; right: 43%; }
  .spreader-img { display: block; width: 100%; height: auto; filter: drop-shadow(0 6px 10px rgba(0, 0, 0, .35)); }
  /* drawn stand-in until the spreader photo arrives: a steel frame with twistlocks at the corners */
  .spreader-bar {
    position: relative; display: block; height: 16px; border-radius: 2px;
    background: linear-gradient(180deg, #dfe7ef, #9fb0c2);
    box-shadow: inset 0 -3px 0 rgba(4, 20, 41, .3);
  }
  .spreader-bar::before, .spreader-bar::after {
    content: ""; position: absolute; top: 100%; width: 10px; height: 6px; background: #f2b134; border-radius: 0 0 2px 2px;
  }
  .spreader-bar::before { left: 3%; }
  .spreader-bar::after { right: 3%; }

  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; }
    .slots { grid-template-columns: 1fr; }
  }
</style>
